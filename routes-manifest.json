      "regex": "^/api/clips/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/clips/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
