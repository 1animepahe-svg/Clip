# Database (SQLite file; use an absolute path in production, e.g. file:/data/clipwave.db)
DATABASE_URL="file:./data/clipwave.db"
# Where uploads, clips and exports are written
DATA_DIR="./data"
# Public base URL
APP_URL="http://localhost:3000"
# Run the ffmpeg/ffprobe queue inside the web process (set 0 and run `npm run worker` in production)
WORKER_INLINE=1

# Optional: AI transcription + clip selection (OpenAI or any compatible endpoint)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# TRANSCRIBE_MODEL=whisper-1

# Optional: platform discovery
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# YOUTUBE_API_KEY=

# Optional: explicit binaries
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp
YTDLP_PATH="C:\\Users\\Nurudeen\\AppData\\Local\\Packages\\PythonSoftwareFoundation.Python.3.12_qbz5n2kfra8p0\\LocalCache\\local-packages\\Python312\\Scripts\\yt-dlp.exe"
